{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "description": "Backup and disaster-recovery status published via BACKUP_STATUS_FILE and alerted by backup-monitoring.yml",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "doc",
      "tags": [],
      "targetBlank": true,
      "title": "Disaster Recovery runbook",
      "type": "link",
      "url": "https://github.com/Mikey-222/stellar-nebula-nomad/blob/main/DISASTER_RECOVERY.md"
    }
  ],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Last Backup Success",
      "type": "stat",
      "targets": [{ "expr": "backup_success", "legendFormat": "Success", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 86400 }, { "color": "red", "value": 172800 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Time Since Last Backup",
      "type": "stat",
      "targets": [{ "expr": "time() - backup_last_success_timestamp", "legendFormat": "Age", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "s",
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 900 }, { "color": "red", "value": 1800 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Backup Duration",
      "type": "stat",
      "targets": [{ "expr": "backup_duration_seconds", "legendFormat": "Duration", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Last Backup Size",
      "type": "stat",
      "targets": [{ "expr": "backup_size_bytes", "legendFormat": "Size", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.2 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "id": 5,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Storage Utilisation",
      "type": "gauge",
      "targets": [{ "expr": "1 - (backup_storage_available_bytes / clamp_min(backup_storage_total_bytes, 1))", "legendFormat": "Used", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "id": 6,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Days Since Last DR Drill",
      "type": "stat",
      "targets": [{ "expr": "(time() - last_drill_timestamp) / 86400", "legendFormat": "Days", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 7,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "title": "Backup Size Over Time",
      "type": "timeseries",
      "targets": [
        { "expr": "backup_size_bytes", "legendFormat": "Backup size", "refId": "A" },
        { "expr": "avg_over_time(backup_size_bytes[7d])", "legendFormat": "7d average", "refId": "B" }
      ]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 8,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "title": "Backup Duration Over Time",
      "type": "timeseries",
      "targets": [{ "expr": "backup_duration_seconds", "legendFormat": "Duration", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 12 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "background" },
      "title": "Last Recovery Success",
      "type": "stat",
      "targets": [{ "expr": "recovery_success", "legendFormat": "Success", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 12 },
      "id": 10,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Recovery Duration",
      "type": "stat",
      "targets": [{ "expr": "recovery_duration_seconds", "legendFormat": "Duration", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 12 },
      "id": 11,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto", "colorMode": "value" },
      "title": "Storage Available",
      "type": "stat",
      "targets": [{ "expr": "backup_storage_available_bytes", "legendFormat": "Available", "refId": "A" }]
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "lineWidth": 2 }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 12,
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list" } },
      "title": "Recovery Duration Over Time",
      "type": "timeseries",
      "targets": [{ "expr": "recovery_duration_seconds", "legendFormat": "Recovery", "refId": "A" }]
    }
  ],
  "refresh": "1m",
  "schemaVersion": 38,
  "tags": ["stellar", "nebula", "backup", "recovery", "disaster-recovery"],
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "title": "Stellar Nebula Nomad — Backup & Recovery",
  "uid": "nebula-backup-recovery",
  "version": 1
}
